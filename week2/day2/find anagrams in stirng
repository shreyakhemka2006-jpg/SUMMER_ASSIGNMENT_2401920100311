class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        int m=s.length();
        int n=p.length();
        
        List<Integer> ans=new ArrayList<>();
        if(n>m){
            return ans;
        }
        int[] f=new int[26];
        int[] q=new int[26];
        for(int i=0;i<n;i++){
            f[s.charAt(i)-'a']++;
            q[p.charAt(i)-'a']++;

        }
        if(Arrays.equals(f,q)){
            ans.add(0);
        }
        for(int i=n;i<m;i++){
             f[s.charAt(i)-'a']++;
            f[s.charAt(i-n)-'a']--;
            if(Arrays.equals(f,q)){
                ans.add(i-n+1);
            }
        }
        return ans;
    }
       
}
