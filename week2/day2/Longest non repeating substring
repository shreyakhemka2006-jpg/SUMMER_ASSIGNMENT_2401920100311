class Solution {
    public int lengthOfLongestSubstring(String s) {
        int l=0;
        int r=0;
        int n=s.length();
        int max=0;
        boolean[] seen=new boolean[128];
        while(r<n){
            if(!seen[s.charAt(r)]){
               seen[ s.charAt(r)]=true;

                r++;
                max=Math.max(max,r-l);

            }
            else{
                
                seen[s.charAt(l)]=false;
                l++;
            }
        }
        return max;
    }
}
